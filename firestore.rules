rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single-owner app: view is open to everyone, only the owner
    // account may modify the data.
    // Deploy via: Firebase Console -> Firestore Database -> Rules
    //        or: firebase deploy --only firestore:rules
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'zadbanny@gmail.com';
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}